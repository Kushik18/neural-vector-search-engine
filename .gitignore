# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*.class
*.so

# Virtual Environments
.venv/
venv/
ENV/
env/

# IDE and Editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store

# Large Raw Datasets (>50MB, exceeds GitHub limits)
Products/*.csv
Jobs/*.csv

# Heavy Precomputed Binary Embeddings & FAISS Indexes
# (Regenerated automatically via python main.py)
indexes/*.npy
indexes/*.index
indexes/*.pkl

# Run logs
*.log
